# Copy to .env for Docker Compose. Keep secrets out of version control.
ANTHROPIC_API_KEY=
OMNIS_MODEL=claude-sonnet-5-5
OMNIS_API_TOKEN=
OMNIS_API_KEY_PEPPER=  # generate at least 32 random characters; keep secret
# OMNIS_PROVISIONING_DATABASE_URL=postgresql://omnis_owner:REPLACE_ME@db.example.com:5432/omnis?sslmode=verify-full
OMNIS_BIND_ADDRESS=127.0.0.1
OMNIS_TENANT_ASSISTANT_RPM=30

# Optional: configure only after applying migrations 001-017 and provisioning
# a dedicated non-owner runtime role with the grants in migrations/README.md.
# OMNIS_DATABASE_URL=postgresql://omnis_app:REPLACE_ME@db.example.com:5432/omnis?sslmode=verify-full

# Source acquisition is disabled unless both allowlist and signing key are set.
OMNIS_SOURCE_ALLOWLIST=
OMNIS_PROVENANCE_PRIVATE_KEY_B64=
OMNIS_SOURCE_FETCHER_ID=omnis-source-fetcher
