# copy to .env
ANTHROPIC_API_KEY=            # enables POST /v1/assistant
OMNIS_MODEL=claude-sonnet-5-5
OMNIS_API_TOKEN=              # if set, /v1/* requires "Authorization: Bearer <token>"

# Required only for tenant-aware identity credentials after migration 006.
OMNIS_API_KEY_PEPPER=     # separate secret, at least 32 characters; never commit
